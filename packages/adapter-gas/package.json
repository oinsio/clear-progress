{
  "name": "@clear-progress/adapter-gas",
  "private": true,
  "type": "module",
  "main": "./dist/client/index.js",
  "types": "./dist/client/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.client.json && node esbuild.config.mjs && cp appsscript.json dist/ && cp authorize.js dist/",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "lint": "biome check .",
    "lint:fix": "biome check . --write"
  },
  "dependencies": {
    "@clear-progress/contract": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/vitest-runner": "^9.6.0",
    "@types/google-apps-script": "^1.0.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  }
}
