# implements D7 of add-supabase-adapter
# Required environment variables for adapter-supabase
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------------------
# Supabase project settings (from Project Settings → API in Supabase dashboard)
# ---------------------------------------------------------------------------

# Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — safe to expose to browsers; enforces RLS
SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — KEEP SECRET, bypasses RLS; used only in Edge Functions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Contract tests (tests/contract.test.ts)
# Used only during testing; never set in production Edge Functions.
# ---------------------------------------------------------------------------

# Base URL for deployed Edge Functions (e.g. https://your-project-ref.supabase.co/functions/v1)
TEST_SUPABASE_URL=https://your-project-ref.supabase.co/functions/v1

# A valid Supabase JWT for the test user (obtain via supabase auth signin or test helper)
TEST_SUPABASE_TOKEN=eyJhbGci...

# Supabase project REST URL (e.g. https://your-project-ref.supabase.co)
TEST_SUPABASE_PROJECT_URL=https://your-project-ref.supabase.co

# Service role key for test teardown (clears test user data between runs)
TEST_SUPABASE_SERVICE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Deployment (scripts/deploy.sh)
# ---------------------------------------------------------------------------

# Your Supabase project ref (the short ID, e.g. xyzcompany from the URL)
SUPABASE_PROJECT_REF=your-project-ref
