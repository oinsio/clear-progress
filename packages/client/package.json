{
  "name": "@clear-progress/client",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "build": "tsc -b && vite build --mode prod",
    "build:qa": "tsc -b && vite build --mode qa",
    "preview": "vite preview --mode prod",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:bdd:gen": "npx bddgen -c playwright.bdd.config.ts",
    "test:bdd": "npx bddgen -c playwright.bdd.config.ts && playwright test -c playwright.bdd.config.ts",
    "test:bdd:a11y": "npx bddgen --tags '@NFR-A1 or @NFR-A2 or @NFR-A3' -c playwright.bdd.config.ts && playwright test -c playwright.bdd.config.ts",
    "test:bdd:responsive": "npx bddgen --tags '@NFR-R1' -c playwright.bdd.config.ts && playwright test -c playwright.bdd.config.ts",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:bdd && pnpm test:e2e",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "typecheck": "tsc --noEmit",
    "i18n:check": "npx tsx scripts/i18n-check/cli.ts"
  },
  "dependencies": {
    "@clear-progress/adapter-supabase": "workspace:*",
    "@clear-progress/contract": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.3.0",
    "fractional-indexing": "^3.2.0",
    "i18next": "^25.8.19",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "temporal-polyfill": "^0.3.2",
    "workbox-window": "^7.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^5.2.1",
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "^2.4.13",
    "@clear-progress/adapter-inmemory": "workspace:*",
    "@playwright/test": "^1.49.1",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/vitest-runner": "^9.6.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "pdfjs-dist": "5.4.296",
    "playwright-bdd": "^8.5.0",
    "postcss": "^8.4.49",
    "react-pdf": "^10.4.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.4"
  }
}
